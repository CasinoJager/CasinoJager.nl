---
// The CJ mark, inline so it inherits colour from CSS and costs no extra request.
//
// One tone, taken from the surrounding `color`. Restyling later means setting
// `color` on this element or an ancestor — nothing to change in here.
// The same mark exists as static files under public/logo/.

interface Props {
  /** Rendered height. Any CSS length. */
  size?: string;
  /** Accessible name. Omit when nearby text already names the site. */
  label?: string;
  class?: string;
}

const { size = '4rem', label, class: className } = Astro.props;
---

<svg
  class:list={['cj-mark', className]}
  viewBox="0 0 93.260391 104"
  style={`--cj-mark-size:${size}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  fill="currentColor"
  shape-rendering="geometricPrecision"
>
  <path
    d="M55.556281 20.458311 27.292661 28.03131 19.946525 29.999635 19.852518 37.749437V69.86755C32.388912 66.508361 25.167369 68.443673 37.70411 65.083848V83.541779L2 93.108864L2.000289 37.749437L2 16.350178L22.689633 10.806726L55.556281 2V20.458311Z"
  />
  <path
    d="M55.556281 20.458311 91.260391 10.891136 91.260102 66.250563C91.260391 72.603084 89.173603 78.498921 85.535051 83.241111C81.886728 87.995442 76.719885 91.545363 70.570816 93.193274L37.70411 102V83.541779L65.967845 75.96869C68.231201 75.362264 70.097944 74.101369 71.378901 72.432008C72.668588 70.751662 73.408509 68.608215 73.407931 66.250563V34.132508C60.871768 37.491639 68.093196 35.556327 55.556281 38.916152V20.458311Z"
  />
</svg>

<style>
  .cj-mark {
    display: block;
    height: var(--cj-mark-size);
    width: auto;
  }
</style>
